APP_NAME="Apps a la con"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
SERVER_PORT=8080

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=apps_a_la_con
DB_USERNAME=laravel
DB_PASSWORD=change_me

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Le mail "reel" est configure depuis l'admin (table mail_settings),
# ces valeurs ne servent que de fallback avant la premiere config.
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
